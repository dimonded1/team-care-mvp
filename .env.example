# Server-only Bitrix configuration.
# Copy to .env on the trusted server and replace placeholders there. Never use a VITE_ prefix.

BITRIX_ENABLED=false
BITRIX_ANIMAL_SYNC_ENABLED=false
BITRIX_GUARDIANSHIP_LEADS_ENABLED=false
BITRIX_CARE_EVENTS_ENABLED=false
BITRIX_CONTACTS_ENABLED=false

# The incoming webhook URL contains a Bitrix access token and must stay secret.
BITRIX_WEBHOOK_URL=<https-bitrix-incoming-webhook-url>
# Secret used only to authorize requests to the future NIKA server endpoint.
BITRIX_WEBHOOK_SECRET=<generated-server-secret>

# Animal source and field map.
BITRIX_ANIMAL_CATEGORY_ID=<animal-deal-category-id>
# Comma-separated deal funnels used by the read-only snapshot sync.
BITRIX_ANIMAL_CATEGORY_IDS=<animal-deal-category-id>,<second-animal-deal-category-id>
# Human-readable public labels: id:name|id:name.
BITRIX_ANIMAL_CATEGORY_LABELS=<id:public-name|id:public-name>
BITRIX_ANIMAL_FIELD_ID=<animal-id-field-id>
BITRIX_ANIMAL_FIELD_NAME=<animal-name-field-id>
BITRIX_ANIMAL_FIELD_SPECIES=<animal-species-field-id>
BITRIX_ANIMAL_FIELD_SEX=<animal-sex-field-id>
BITRIX_ANIMAL_FIELD_BIRTH_DATE=<animal-birth-date-field-id>
BITRIX_ANIMAL_FIELD_MAIN_PHOTO=<animal-main-photo-field-id>
BITRIX_ANIMAL_FIELD_EXTRA_PHOTOS=<animal-extra-photos-field-id>
BITRIX_ANIMAL_FIELD_STORY=<animal-story-field-id>
BITRIX_ANIMAL_FIELD_DESCRIPTION=<animal-description-field-id>
BITRIX_ANIMAL_FIELD_CHARACTER=<animal-character-field-id>
BITRIX_ANIMAL_FIELD_BEHAVIOR=<animal-behavior-field-id>
BITRIX_ANIMAL_FIELD_PROFILE_URL=<animal-profile-url-field-id>
BITRIX_ANIMAL_FIELD_PUBLISHED=<animal-published-field-id>
BITRIX_ANIMAL_FIELD_BLOCK_FROM_SITE=<animal-block-from-site-field-id>
BITRIX_ANIMAL_FIELD_NOT_FOR_GUARDIANSHIP=<animal-not-for-guardianship-field-id>
BITRIX_ANIMAL_FIELD_SITE_ID=<animal-site-id-field-id>

# Enumeration values must be confirmed through Bitrix metadata before enabling.
BITRIX_ANIMAL_ENUM_SPECIES_CAT=<cat-enum-id>
BITRIX_ANIMAL_ENUM_SPECIES_DOG=<dog-enum-id>
BITRIX_ANIMAL_ENUM_SEX_FEMALE=<female-enum-id>
BITRIX_ANIMAL_ENUM_SEX_MALE=<male-enum-id>

# Optional outbound guardianship lead.
BITRIX_GUARDIANSHIP_FORM_ID=<guardianship-form-id>
BITRIX_FIELD_GUARDIAN_NAME=<guardian-name-field-id>
BITRIX_FIELD_GUARDIAN_EMAIL=<guardian-email-field-id>
BITRIX_FIELD_GUARDIAN_PHONE=<guardian-phone-field-id>
BITRIX_FIELD_ANIMAL_ID=<animal-id-field-id>
BITRIX_FIELD_ANIMAL_NAME=<animal-name-field-id>
BITRIX_FIELD_CONSENT=<consent-field-id>

# Optional lightweight contact request created after the care route.
# NAME, LAST_NAME, SECOND_NAME, PHONE, EMAIL, BIRTHDATE and ADDRESS are standard fields.
BITRIX_CONTACT_SOURCE_ID=<contact-source-id>
# Optional free text stored next to the source, e.g. which stand or event this is.
BITRIX_CONTACT_SOURCE_DESCRIPTION=<contact-source-description>
BITRIX_CONTACT_FIELD_TELEGRAM=<contact-telegram-field-id>
BITRIX_CONTACT_FIELD_ABOUT=<contact-about-field-id>
BITRIX_CONTACT_FIELD_WORK_SPHERE=<contact-work-sphere-field-id>
BITRIX_CONTACT_FIELD_HOBBIES=<contact-hobbies-field-id>
BITRIX_CONTACT_FIELD_PETS=<contact-pets-field-id>
BITRIX_CONTACT_FIELD_PREFERRED_CONTACT=<contact-preferred-contact-field-id>
BITRIX_CONTACT_FIELD_MAX=<contact-max-field-id>
BITRIX_CONTACT_FIELD_INTEREST=<contact-interest-field-id>
BITRIX_CONTACT_FIELD_CONSENT=<contact-consent-field-id>
BITRIX_CONTACT_FIELD_CONSENT_AT=<contact-consent-date-field-id>
BITRIX_CONTACT_FIELD_SUBMITTED_AT=<contact-submission-date-field-id>
# Enumeration IDs must be copied from Bitrix field metadata, not guessed.
BITRIX_CONTACT_INTEREST_GUARDIANSHIP_ENUM_ID=<guardianship-interest-enum-id>
# Optional: visitors arriving with one of the campaign marks below (?e=... or
# ?utm_campaign=...) also get this interest, on top of the guardianship one.
# Leave both empty and every submission keeps the guardianship interest only.
BITRIX_CONTACT_INTEREST_EVENT_ENUM_ID=<event-interest-enum-id>
BITRIX_CONTACT_EVENT_CAMPAIGNS=<comma-separated-campaign-marks>
BITRIX_CONTACT_WORK_PUBLIC_SERVICE_ENUM_ID=<public-service-enum-id>
BITRIX_CONTACT_WORK_BUDGET_ORGANIZATION_ENUM_ID=<budget-organization-enum-id>
BITRIX_CONTACT_WORK_MEDIA_ENUM_ID=<media-enum-id>
BITRIX_CONTACT_WORK_RESEARCH_ENUM_ID=<research-enum-id>
BITRIX_CONTACT_WORK_SOCIAL_ENTERPRISE_ENUM_ID=<social-enterprise-enum-id>
BITRIX_CONTACT_WORK_SELF_EMPLOYED_ENUM_ID=<self-employed-enum-id>
BITRIX_CONTACT_WORK_RUSSIAN_BUSINESS_ENUM_ID=<russian-business-enum-id>
BITRIX_CONTACT_WORK_INTERNATIONAL_BUSINESS_ENUM_ID=<international-business-enum-id>
BITRIX_CONTACT_WORK_SOCIAL_NONPROFIT_ENUM_ID=<social-nonprofit-enum-id>
BITRIX_CONTACT_WORK_OTHER_ENUM_ID=<other-work-enum-id>
BITRIX_CONTACT_PREFERRED_WHATSAPP_ENUM_ID=<whatsapp-enum-id>
BITRIX_CONTACT_PREFERRED_PHONE_ENUM_ID=<phone-enum-id>
BITRIX_CONTACT_PREFERRED_EMAIL_ENUM_ID=<email-enum-id>
BITRIX_CONTACT_PREFERRED_TELEGRAM_ENUM_ID=<telegram-enum-id>
BITRIX_CONTACT_PREFERRED_MAX_ENUM_ID=<max-enum-id>

# Optional care analytics smart-process item.
BITRIX_CARE_EVENT_ENTITY_TYPE_ID=<smart-process-entity-type-id>
BITRIX_FIELD_CARE_TYPE=<care-type-field-id>
BITRIX_FIELD_OCCURRED_AT=<occurred-at-field-id>

# Same-origin application server.
PORT=8080
APP_ALLOWED_ORIGINS=<https-production-origin>
# Enable only when the app is behind a trusted reverse proxy that overwrites
# X-Forwarded-For and X-Forwarded-Proto.
APP_TRUST_PROXY=false
CONTACT_CAPTURE_RATE_LIMIT=60
CONTACT_CAPTURE_RATE_WINDOW_MS=600000
