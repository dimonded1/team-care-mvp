{
  "name": "nika-team-care-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "sync:animals": "node --env-file=.env scripts/sync-bitrix-animals.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "vitest run",
    "test:server": "node --test integrations/bitrix/bitrix.node-test.mjs server/contact-capture.node-test.mjs",
    "test:watch": "vitest",
    "smoke": "node scripts/cdp-smoke.mjs"
  },
  "dependencies": {
    "framer-motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
